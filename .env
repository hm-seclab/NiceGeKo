# SPDX-License-Identifier: MIT
# =============================================================================
# Central configuration for the posture-gated eduVPN stack — single source of truth.
# =============================================================================
# docker compose reads this file automatically; the shell scripts source it too.
# Change any value in ONE place here.
#
# DEMO SECRETS: every credential below is a throwaway PoC default committed on
# purpose so the stack is one-command reproducible. CHANGE ALL OF THEM for any
# real deployment and move them into a proper secret store.
#
# VALUE SYNTAX: keep values to plain unquoted tokens (no spaces, '#', quotes, or
# backslashes). Both `docker compose` and the shell scripts source this file with
# `set -a; . ./.env`, and the two parsers diverge on those characters.
# =============================================================================

# --- eduVPN server hostname (the FQDN the client connects to) ----------------
VPN_FQDN=vpn.local

# --- step-ca (CA) ------------------------------------------------------------
# NOTE: CA_PASSWORD is fixed when the CA is first initialised — it encrypts the CA
# private keys stored on the 'step-ca-data' volume, so changing it later cannot
# re-key them. ca-entrypoint.sh detects a mismatch and refuses to start rather than
# leaving the stack up with a CA that can no longer issue device certificates.
# To change it: ./down.sh --clean && ./up.sh  (destroys the existing PKI).
CA_NAME=eduVPN-CA
CA_DNS_NAMES=ca-server,localhost
CA_PASSWORD=eduvpn-demo-ca-password
# Lifetime of issued leaf certs (device certs + the eduVPN server TLS cert).
# step-ca's own default is 24h, which would silently expire a demo stack left
# running overnight; nothing in the images renews them. Applied at CA init.
CA_LEAF_DURATION=2160h

# --- Wazuh API credentials (freely changeable) -------------------------------
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=MyS3cr37P450r.*-
# --- Wazuh indexer / dashboard credentials -----------------------------------
# NOTE: the indexer password is ALSO stored as a bcrypt hash in
# wazuh-server/config/wazuh_indexer/internal_users.yml — to change it you must
# regenerate that hash too, not just edit this value.
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=SecretPassword
DASHBOARD_PASS=kibanaserver

# --- eduVPN portal demo account ----------------------------------------------
DEMO_USER=vpn
DEMO_PASS=admin

# --- image / package versions ------------------------------------------------
STEP_CA_VERSION=0.30.2
STEP_CLI_VERSION=0.29.0
WAZUH_VERSION=4.14.3
