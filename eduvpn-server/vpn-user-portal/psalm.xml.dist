<?xml version="1.0"?>
<psalm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://getpsalm.org/schema/config" errorLevel="1" resolveFromConfigFile="true" xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd" findUnusedCode="false" findUnusedBaselineEntry="true">
  <projectFiles>
    <directory name="src"/>
    <directory name="bin"/>
    <directory name="web"/>
    <directory name="libexec"/>
    <directory name="views"/>
    <directory name="tests"/>
    <ignoreFiles>
      <directory name="vendor"/>
    </ignoreFiles>
  </projectFiles>
  <plugins>
    <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
  </plugins>
</psalm>
